---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { loadRepoHistory } from '../../lib/history';
import { sparkline } from '../../lib/viz';
import { zhDesc } from '../../utils/zh';

const base = import.meta.env.BASE_URL;

// Load data
let index: any = { projects: [] };
const repoHistory = loadRepoHistory();
try { index = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8')); } catch {}

let intelligence: any = { categories: [] };
try { intelligence = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch {}

export function getStaticPaths() {
  let cats: any = { categories: [] };
  try { cats = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch {}
  return (cats.categories || []).map((c: any) => ({
    params: { name: c.category.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { category: c.category },
  }));
}

const { category } = Astro.props;

// Filter projects by category
const projects = (index.projects || [])
  .filter((p: any) => p.category === category)
  .sort((a: any, b: any) => {
      const sa = a.radar_score || 0;
      const sb = b.radar_score || 0;
      if (sa !== sb) return sb - sa;
      return (b.stars || 0) - (a.stars || 0);
    });

// Find category metadata
const catMeta = (intelligence.categories || []).find((c: any) => c.category === category);

function fmtStars(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}

function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}

function momentumBadge(score: number): { label: string; key: string; cls: string } {
  if (score >= 80) return { label: 'Breakout', key: 'momentum.breakout', cls: 'badge-accent' };
  if (score >= 65) return { label: 'Accelerating', key: 'momentum.accelerating', cls: 'badge-success' };
  if (score >= 45) return { label: 'Rising', key: 'momentum.rising', cls: 'badge-info' };
  if (score > 0) return { label: 'Stable', key: 'momentum.stable', cls: 'badge-muted' };
  return { label: '—', key: '', cls: 'badge-muted' };
}

function ownerInitials(fullName: string): string {
  const owner = fullName.split('/')[0] || '?';
  return owner.replace(/[^a-zA-Z0-9]/g, '').substring(0, 2).toUpperCase() || '?';
}
---

<Layout title={`${category} — Open Source AI Radar`} description={`Top open-source AI projects in the ${category} category.`}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}categories`} data-i18n="nav.categories">Categories</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page" data-i18n-cat={category}>{category}</span>
  </nav>
  <div class="page-head">
    <div class="page-head__main">
      <div class="page-head__eyebrow" data-i18n="nav.categories">Categories</div>
      <h1 class="page-head__title" data-i18n-cat={category}>{category}</h1>
      <p class="page-head__sub">
        <span data-i18n="category.projectsTracked" data-i18n-vars={JSON.stringify({ n: projects.length })}>{projects.length} projects tracked</span>
      </p>
      <div class="meta-chips">
        {catMeta?.trend && <span class={`meta-chip ${(catMeta.trend === 'rising') ? 'badge-success' : (catMeta.trend === 'declining') ? 'badge-warning' : 'badge-muted'}`} data-i18n={`trend.${catMeta.trend}`}>{catMeta.trend}</span>}
        {catMeta && <span class="meta-chip"><b>{catMeta.velocity?.toFixed(0) || '—'}</b> <span data-i18n="categories.avgVelocity">Avg Velocity</span></span>}
        {catMeta && <span class="meta-chip"><b>{catMeta.health?.toFixed(0) || '—'}</b> <span data-i18n="categories.avgHealth">Avg Health</span></span>}
      </div>
    </div>
  </div>

  <div style="display:flex; flex-direction:column; gap:var(--sp-3);">
    {projects.map((p: any, i: number) => {
      const mb = momentumBadge(p.radar_score || 0);
      return (
        <a href={repoUrl(p.full_name)} class="project-row" style="text-decoration:none; color:inherit;">
          <span class="project-rank" style="font-size:var(--text-sm);">#{i + 1}</span>
          {p.owner_avatar
            ? <img src={p.owner_avatar} alt="" class="project-avatar" width="32" height="32" loading="lazy" data-owner={p.full_name} referrerpolicy="no-referrer" />
            : <div class="avatar-slot avatar-fallback">{ownerInitials(p.full_name)}</div>}
          <div class="project-info">
            <div style="font-weight:600; font-size:var(--text-sm); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{p.full_name}</div>
            <div style="font-size:var(--text-xs); color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" data-desc-en={p.description || ''} data-desc-zh={zhDesc(p.description)}>{p.description || ''}</div>
          </div>
          <div class="project-meta">
            {p.language && <span class="badge badge-sm badge-muted">{p.language}</span>}
            <span class="project-stars">{fmtStars(p.stars)} ★</span>
            <span style="font-size:var(--text-sm); font-weight:700; min-width:40px; text-align:right;">{p.radar_score ? p.radar_score.toFixed(0) : "—"}</span>
            <Fragment set:html={sparkline(repoHistory[p.full_name] || [])} />
            <span class={`badge badge-sm ${mb.cls}`} set:html={mb.key ? `<span data-i18n="${mb.key}">${mb.label}</span>` : mb.label}></span>
          </div>
        </a>
      );
    })}
  </div>

  {projects.length === 0 && (
    <div class="card" style="padding:var(--sp-8); text-align:center; color:var(--text-muted);" data-i18n="category.empty">
      No projects found in this category yet.
    </div>
  )}
</Layout>
