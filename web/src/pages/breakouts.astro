---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { meter } from '../lib/viz';

const base = import.meta.env.BASE_URL;
let breakouts: any = { candidates: [] };
try { breakouts = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'breakouts.json'), 'utf-8')); } catch {}

const avatarByRepo = (() => {
  try {
    const idx = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8'));
    const map: Record<string, string> = {};
    for (const p of idx.projects || []) if (p.full_name && p.owner_avatar) map[p.full_name] = p.owner_avatar;
    return map;
  } catch { return {} as Record<string, string>; }
})();

function ownerInitials(fullName: string): string {
  const owner = fullName.split('/')[0] || '?';
  return owner.replace(/[^a-zA-Z0-9]/g, '').substring(0, 2).toUpperCase() || '?';
}

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}
function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}
function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}
---

<Layout title="Breakouts" description="Projects predicted to break out based on momentum signals.">
  <div class="page-head">
    <div class="page-head__main">
      <div class="page-head__eyebrow" data-i18n="breakouts.accent">Breakout</div>
      <h1 class="page-head__title"><span class="accent" data-i18n="breakouts.accent">Breakout</span> <span data-i18n="breakouts.suffix">Candidates</span></h1>
      <p class="page-head__sub" data-i18n="breakouts.subtitle">Projects showing early signs of explosive growth</p>
    </div>
    <div class="page-head__aside">
      <div class="meta-chips">
        <span class="meta-chip"><b>{(breakouts.candidates || []).length}</b> <span data-i18n="breakouts.suffix">candidates</span></span>
      </div>
    </div>
  </div>

  {breakouts.candidates && breakouts.candidates.length > 0 ? (
    <div class="grid-auto">
      {(breakouts.candidates || []).map((r: any, i: number) => (
      <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-6); text-decoration:none; color:inherit;">
        <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-3);">
          <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">#{i + 1}</span>
          {avatarByRepo[r.repo_full_name]
            ? <img src={avatarByRepo[r.repo_full_name]} alt="" width="28" height="28" style="width:28px; height:28px; border-radius:50%; object-fit:cover; flex-shrink:0;" loading="lazy" data-owner={r.repo_full_name} referrerpolicy="no-referrer" />
            : <span class="avatar-fallback" style="width:28px; height:28px; font-size:11px;">{ownerInitials(r.repo_full_name)}</span>}
          <span style="font-weight:700; font-size:var(--text-base);">{r.repo_full_name}</span>
        </div>
        <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-4);">
          <span class={`score-pill ${scoreClass(r.breakout_score)}`}>{r.breakout_score}</span>
          <span class="momentum momentum-breakout"><span data-i18n="momentum.breakout">Breakout</span></span>
        </div>
        <div style="margin-bottom:var(--sp-4);">
          <div style="display:flex;justify-content:space-between;font-size:var(--text-xs);color:var(--text-muted);margin-bottom:4px;">
            <span data-i18n="breakouts.scoreLabel">Breakout Score</span>
            <span style="font-family:var(--font-mono);">{r.breakout_score}</span>
          </div>
          <Fragment set:html={meter(r.breakout_score || 0, (r.breakout_score || 0) >= 70 ? 'green' : '')} />
        </div>
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:var(--sp-3);">
          <div>
            <div style="font-size:var(--text-xs); color:var(--text-muted);" data-i18n="label.stars">Stars</div>
            <div style="font-size:var(--text-sm); font-weight:600;">{fmt(r.stars || 0)}</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs); color:var(--text-muted);" data-i18n="label.velocity">Velocity</div>
            <div style="font-size:var(--text-sm); font-weight:600;">{r.velocity?.toFixed(0)}</div>
          </div>
          <div>
            <div style="font-size:var(--text-xs); color:var(--text-muted);" data-i18n="breakouts.acceleration">Acceleration</div>
            <div style="font-size:var(--text-sm); font-weight:600;">{r.star_growth_acceleration?.toFixed(1)}x</div>
          </div>
        </div>
      </a>
    ))}
    </div>
  ) : (
    <div class="card" style="padding:var(--sp-8); text-align:center; color:var(--text-muted);">
      <div style="font-size:var(--text-2xl); font-weight:700; margin-bottom:var(--sp-3); color:var(--text);" data-i18n="breakouts.emptyTitle">No breakouts detected yet</div>
      <p style="max-width:480px; margin:0 auto var(--sp-4);">Breakout detection compares each project's star velocity against its own history. The pipeline needs a few days of snapshots to build that baseline.</p>
      <p style="margin:0; font-size:var(--text-xs);">Snapshots are collected automatically every 6 hours — check back soon.</p>
    </div>
  )}
</Layout>
