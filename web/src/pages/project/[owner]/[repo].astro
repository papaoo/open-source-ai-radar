---
import Layout from '../../../layouts/Layout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
import { topProjectSet } from '../../../utils/og';
import { zhDesc } from '../../../utils/zh';
import { tf } from '../../../lib/i18n';
import { gauge, trendChart, meter, deltaChip } from '../../../lib/viz';

export function getStaticPaths() {
  const projectsDir = join(process.cwd(), '..', 'data', 'exports', 'projects');
  try {
    const files = readdirSync(projectsDir).filter(f => f.endsWith('.json'));
    return files.map(f => {
      const name = f.replace('.json', '');
      const [owner, repo] = name.split('__');
      return { params: { owner, repo } };
    });
  } catch (e) {
    return [];
  }
}

const { owner, repo } = Astro.params;
const base = import.meta.env.BASE_URL;

const projectKey = `${owner}__${repo}`;
const fullName = `${owner}/${repo}`;
const projectPath = join(process.cwd(), '..', 'data', 'exports', 'projects', `${projectKey}.json`);
const historyPath = join(process.cwd(), '..', 'data', 'exports', 'history', `${projectKey}.json`);

let project: any = null;
let history: any = null;

try { project = JSON.parse(readFileSync(projectPath, 'utf-8')); } catch {}
try { history = JSON.parse(readFileSync(historyPath, 'utf-8')); } catch {}

if (!project) {
  return Astro.redirect(`${base}`);
}

// ── Lookups: projects-index (category percentile + related), opportunities ──
const idxProjects: any[] = (() => {
  try {
    const idx = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8'));
    return idx.projects || [];
  } catch { return []; }
})();

const oppByRepo: Record<string, any> = (() => {
  try {
    const o = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'opportunities.json'), 'utf-8'));
    const map: Record<string, any> = {};
    for (const c of o.candidates || []) if (c.repo_full_name) map[c.repo_full_name] = c;
    return map;
  } catch { return {}; }
})();
const opp = oppByRepo[fullName] || null;

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return (Number(n) || 0).toString();
}

function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}

function momentumState(v: number, a: number): string {
  if (a >= 2.0 && v >= 60) return 'breakout';
  if (a >= 1.5 && v >= 50) return 'accelerating';
  if (v >= 40) return 'rising';
  if (v >= 20) return 'stable';
  return 'declining';
}

function momentumLabel(s: string): string {
  return ({ breakout: 'Breakout', accelerating: 'Accelerating', rising: 'Rising', stable: 'Stable', declining: 'Declining' } as any)[s] || '\u2014';
}

const state = momentumState(project.velocity || 0, project.star_growth_acceleration || 1);
const vstory = velocityStory(project.velocity || 0);
const wsegs = whySegments(project);
const topPct = percentileLabel(project.global_percentile);
const socialImage = topProjectSet().has(`${owner}/${repo}`)
  ? `${base}project/${owner}/${repo}/og.png`
  : `${base}og.png`;

function percentileLabel(p: any): number {
  const v = Number(p);
  if (!Number.isFinite(v) || v <= 0) return 0;
  return Math.round(100 - v);
}

// Category-relative percentile: fraction of same-category peers scored lower.
const siblings = idxProjects.filter((p) => p.category && p.category === project.category && p.full_name !== project.full_name);
const myScore = Number(project.radar_score) || 0;
const catPct = siblings.length
  ? Math.round((siblings.filter((p) => (Number(p.radar_score) || 0) <= myScore).length / siblings.length) * 100)
  : 0;

// Related repos: same category, ranked by score, top 6 (exclude self).
const related = siblings
  .slice()
  .sort((a, b) => (Number(b.radar_score) || 0) - (Number(a.radar_score) || 0))
  .slice(0, 6);

function velocityStory(v: number): { key: string; en: string } {
  if (v >= 70) return { key: 'proj.vstory.v70', en: 'Exceptional momentum — gaining stars far faster than almost everything else tracked.' };
  if (v >= 50) return { key: 'proj.vstory.v50', en: 'Strong momentum — adoption is accelerating week over week.' };
  if (v >= 35) return { key: 'proj.vstory.v35', en: 'Steady growth — consistently collecting stars and contributors.' };
  if (v >= 15) return { key: 'proj.vstory.v15', en: 'Modest but positive momentum.' };
  return { key: 'proj.vstory.v0', en: 'Momentum is cooling relative to the rest of the index.' };
}

// Rebuild the "why it ranks" explanation from numeric signals instead of the
// English prose in project.why_trending. Thresholds mirror
// src/radar/analysis/why_trending.py::_generate_explanation exactly, so the
// English view is unchanged and Chinese needs no machine translation.
type WhySeg = { key: string; vars?: Record<string, string | number>; map?: Record<string, string> };
function whySegments(p: any): WhySeg[] {
  const num = (v: any): number => { const n = Number(v); return Number.isFinite(n) ? n : 0; };
  const segs: WhySeg[] = [];
  const stars7 = num(p.stars_7d);
  const accel = p.star_growth_acceleration == null ? 1.0 : Number(p.star_growth_acceleration);
  const vel = num(p.velocity);
  const forks7 = num(p.forks_7d);
  const health = num(p.health);
  const gr7 = num(p.star_growth_rate_7d);
  const gr30 = num(p.star_growth_rate_30d);

  if (stars7 > 0) {
    if (accel && accel > 1.5) segs.push({ key: 'why.rapid', vars: { n: stars7, x: accel.toFixed(1) } });
    else if (stars7 >= 100) segs.push({ key: 'why.strong', vars: { n: stars7 } });
    else if (stars7 >= 20) segs.push({ key: 'why.steady', vars: { n: stars7 } });
  }
  if (vel >= 80) segs.push({ key: 'why.fastest' });
  else if (vel >= 60) segs.push({ key: 'why.aboveAvg' });
  if (forks7 > 10) segs.push({ key: 'why.forks', vars: { n: forks7 } });
  if (health >= 70) segs.push({ key: 'why.wellMaintained' });
  else if (health < 30) segs.push({ key: 'why.declining' });
  if (gr30 > 0 && gr7 / gr30 >= 3.0) segs.push({ key: 'why.starSpike' });
  if (p.category) segs.push({ key: 'why.activeIn', vars: { cat: String(p.category) }, map: { cat: 'category' } });
  if (p.maturity === 'Emerging') segs.push({ key: 'why.emerging' });
  else if (p.maturity === 'Mature') segs.push({ key: 'why.mature' });

  if (!segs.length) {
    const stars = num(p.stars);
    if (stars > 10000) segs.push({ key: 'why.popular' });
    else if (stars > 1000) segs.push({ key: 'why.growing' });
    else segs.push({ key: 'why.positive' });
  }
  return segs;
}

function catSlug(name: string): string {
  return String(name).toLowerCase().replace(/[^a-z0-9]+/g, '-');
}

// ── Time-series for the switchable trend chart (client-rendered via viz) ──
const snaps = history?.snapshots || [];
const scores = history?.scores || [];
const historySeries = {
  stars: snaps.map((s: any) => ({ t: s.timestamp, v: Number(s.stars) })),
  forks: snaps.map((s: any) => ({ t: s.timestamp, v: Number(s.forks) })),
  contributors: snaps.map((s: any) => ({ t: s.timestamp, v: Number(s.contributors) })),
  score: scores.filter((s: any) => s.radar_score != null).map((s: any) => ({ t: s.timestamp, v: Number(s.radar_score) })),
};
const hasSeries = Object.values(historySeries).some((a: any[]) => a.filter((p) => Number.isFinite(p.v)).length >= 2);

// Three-axis score values for the radar chart (rendered client-side so axis
// labels follow the active language).
const radarValues = {
  impact: Number(project.impact) || 0,
  velocity: Number(project.velocity) || 0,
  health: Number(project.health) || 0,
};

const pinIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17v5"/><path d="M9 10.8V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6.8"/><path d="M5 10h14l-1.5 4h-3.5v3h-4v-3H6.5L5 10z"/></svg>';
const ghIco = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>';
const checkIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

const toc = [
  { id: 'overview', key: 'proj.metrics', en: 'Key metrics' },
  { id: 'trend', key: 'proj.starHistory', en: 'History' },
  { id: 'scores', key: 'proj.scoringBreakdown', en: 'Scoring' },
  { id: 'why', key: 'proj.whyRanks', en: 'Why it ranks' },
  ...(opp ? [{ id: 'opportunity', key: 'proj.oppCard', en: 'Opportunity' }] : []),
  ...(related.length ? [{ id: 'related', key: 'proj.related', en: 'Related' }] : []),
];
---

<Layout title={`${owner}/${repo}`} description={project.description || `Project details for ${owner}/${repo}`} ogImage={socialImage}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={`${base}top`} data-i18n="nav.rankings">Rankings</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{fullName}</span>
  </nav>

  <div class="page-head">
    <div class="page-head__main">
      <div class="page-head__eyebrow">
        {project.category && project.category !== 'Uncategorized'
          ? <a href={`${base}category/${catSlug(project.category)}`} style="color:inherit;text-decoration:none;" data-i18n-cat={project.category}>{project.category}</a>
          : <span data-i18n="proj.metrics">Repository</span>}
      </div>
      <h1 class="page-head__title">
        {project.owner_avatar && <img src={project.owner_avatar} alt="" width="40" height="40" style="width:40px;height:40px;border-radius:var(--radius);border:1px solid var(--border);vertical-align:-10px;margin-right:var(--sp-3);" loading="lazy" data-owner={fullName} referrerpolicy="no-referrer" />}
        <span>{owner}</span><span style="color:var(--text-muted);">/</span><span class="accent">{repo}</span>
      </h1>
      {project.description && <p class="page-head__sub" data-desc-en={project.description} data-desc-zh={zhDesc(project.description)}>{project.description}</p>}
      <div class="meta-chips">
        {project.language && <span class="meta-chip">{project.language}</span>}
        {project.maturity && project.maturity !== 'Unknown' && <span class="meta-chip" data-i18n="proj.maturityLabel" data-i18n-vars={JSON.stringify({ v: String(project.maturity) })} data-i18n-map={JSON.stringify({ v: 'maturity' })}>Maturity: {project.maturity}</span>}
        {topPct > 0 && <span class="meta-chip" data-i18n="proj.topPercentile" data-i18n-vars={JSON.stringify({ n: topPct })}>Top {topPct}% globally</span>}
        {Number(project.days_since_last_push) > 0 && <span class="meta-chip" data-i18n="proj.lastPushDays" data-i18n-vars={JSON.stringify({ n: Math.round(Number(project.days_since_last_push)) })}>Last push {Math.round(Number(project.days_since_last_push))}d ago</span>}
      </div>
    </div>
    <div class="page-head__aside">
      <button class="icon-btn pin-btn" type="button" data-full-name={fullName} aria-label="Pin project" title="Pin" data-i18n-aria="pin.add"><Fragment set:html={pinIco} /></button>
      <a href={`https://github.com/${owner}/${repo}`} target="_blank" rel="noopener" class="nav-btn" style="display:inline-flex;align-items:center;gap:var(--sp-2);">
        <Fragment set:html={ghIco} /><span data-i18n="proj.viewOnGitHub">View on GitHub</span>
      </a>
    </div>
  </div>

  <div class="proj-layout">
    <div class="proj-content">

      <!-- Key metrics -->
      <section class="section" id="overview">
        <div class="stat-grid" style="margin-bottom:0;">
          <div class="stat-card">
            <div class="stat-value">{fmt(project.stars || 0)}</div>
            <div class="stat-label" data-i18n="label.stars">Stars</div>
            {Number(project.stars_7d) > 0 && <div style="margin-top:var(--sp-2);"><Fragment set:html={deltaChip(Number(project.stars_7d), { suffix: ' /7d' })} /></div>}
          </div>
          <div class="stat-card">
            <div class="stat-value">{fmt(project.forks || 0)}</div>
            <div class="stat-label" data-i18n="proj.forks">Forks</div>
          </div>
          <div class="stat-card">
            <div class="stat-value"><span class={`score-pill ${scoreClass(project.radar_score)}`} style="font-size:var(--text-xl);">{project.radar_score?.toFixed(1)}</span></div>
            <div class="stat-label" data-i18n="proj.radarScore">Radar Score</div>
          </div>
          <div class="stat-card">
            <div class="stat-value"><span class={`momentum momentum-${state}`}><span data-i18n={`momentum.${state}`}>{momentumLabel(state)}</span></span></div>
            <div class="stat-label" data-i18n="proj.momentum">Momentum</div>
          </div>
        </div>
      </section>

      <!-- History trend chart (switchable series) -->
      <section class="section" id="trend">
        <div class="panel">
          <div class="panel__head">
            <span class="panel__title" data-i18n="proj.starHistory">Star History</span>
            {hasSeries && (
              <div class="panel__actions">
                <div class="segmented" id="trendToggle" role="group" aria-label="Select metric">
                  <button class="segmented__btn active" data-series="stars" aria-pressed="true" data-i18n="proj.starsSeries">Stars</button>
                  <button class="segmented__btn" data-series="forks" aria-pressed="false" data-i18n="proj.forksSeries">Forks</button>
                  <button class="segmented__btn" data-series="contributors" aria-pressed="false" data-i18n="proj.contribsSeries">Contributors</button>
                  <button class="segmented__btn" data-series="score" aria-pressed="false" data-i18n="proj.radarScore">Score</button>
                </div>
              </div>
            )}
          </div>
          <div class="panel__body">
            {hasSeries ? (
              <Fragment set:html={`<script type="application/json" id="historySeriesData">${JSON.stringify(historySeries)}</script><div id="trendChart" data-default="stars"></div><div id="trendRange" style="display:flex;justify-content:space-between;margin-top:var(--sp-2);font-size:var(--text-xs);color:var(--text-muted);font-family:var(--font-mono);"></div>`} />
            ) : (
              <div class="empty-state" style="padding:var(--sp-8) 0;">
                <div class="empty-state__hint" data-i18n="proj.noHistory">No time-series snapshots yet for this project.</div>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Scoring breakdown: gauges + radar -->
      <section class="section" id="scores">
        <div class="panel">
          <div class="panel__head"><span class="panel__title" data-i18n="proj.scoringBreakdown">Scoring Breakdown</span></div>
          <div class="panel__body">
            <div class="score-split">
              <div class="score-split__chart">
                <div id="projectRadar" class="radar-mount" data-impact={radarValues.impact} data-velocity={radarValues.velocity} data-health={radarValues.health}></div>
              </div>
              <div style="display:grid; gap:var(--sp-4); flex:1; min-width:0;">
                <div>
                  <div style="display:flex; justify-content:space-between; margin-bottom:var(--sp-1);">
                    <span style="font-size:var(--text-sm); font-weight:500;" data-i18n="label.impact">Impact</span>
                    <span style="font-family:var(--font-mono); font-size:var(--text-sm); color:var(--text-secondary);">{project.impact?.toFixed(1)}</span>
                  </div>
                  <Fragment set:html={meter(project.impact || 0, '')} />
                </div>
                <div>
                  <div style="display:flex; justify-content:space-between; margin-bottom:var(--sp-1);">
                    <span style="font-size:var(--text-sm); font-weight:500;" data-i18n="label.velocity">Velocity</span>
                    <span style="font-family:var(--font-mono); font-size:var(--text-sm); color:var(--text-secondary);">{project.velocity?.toFixed(1)}</span>
                  </div>
                  <Fragment set:html={meter(project.velocity || 0, 'green')} />
                </div>
                <div>
                  <div style="display:flex; justify-content:space-between; margin-bottom:var(--sp-1);">
                    <span style="font-size:var(--text-sm); font-weight:500;" data-i18n="label.health">Health</span>
                    <span style="font-family:var(--font-mono); font-size:var(--text-sm); color:var(--text-secondary);">{project.health?.toFixed(1)}</span>
                  </div>
                  <Fragment set:html={meter(project.health || 0, (project.health || 0) >= 70 ? 'green' : (project.health || 0) < 30 ? 'red' : 'amber')} />
                </div>
              </div>
            </div>
            <div class="gauge-row">
              {(catPct > 0 || siblings.length > 0) && (
                <div class="gauge-item">
                  <div class="gauge-item__cap" data-i18n="proj.categoryPercentile">In category</div>
                  <Fragment set:html={gauge(catPct, { size: 96, color: 'var(--viz-1)' })} />
                  <div class="gauge-item__sub">{siblings.length + 1} <span data-i18n="unit.peers">peers</span></div>
                </div>
              )}
              {topPct > 0 && (
                <div class="gauge-item">
                  <div class="gauge-item__cap" data-i18n="proj.globalPercentile">Global</div>
                  <Fragment set:html={gauge(topPct, { size: 96, color: 'var(--accent)' })} />
                  <div class="gauge-item__sub"><Fragment set:html={deltaChip(Number(project.stars_7d) || 0, { suffix: ' \u2605 /7d' })} /></div>
                </div>
              )}
              <div class="gauge-item">
                <div class="gauge-item__cap" data-i18n="label.health">Health</div>
                <Fragment set:html={gauge(Math.round(Number(project.health) || 0), { size: 96, color: (project.health || 0) >= 70 ? 'var(--green)' : (project.health || 0) < 30 ? 'var(--red)' : 'var(--amber)' })} />
                <div class="gauge-item__sub" data-i18n="proj.healthGauge">Maintenance</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why it ranks -->
      <section class="section" id="why">
        <div class="panel">
          <div class="panel__head"><span class="panel__title" data-i18n="proj.whyRanks">Why it ranks</span></div>
          <div class="panel__body">
            <p style="color:var(--text-secondary); line-height:var(--leading-relaxed); font-size:var(--text-sm); margin-bottom:var(--sp-4);" data-i18n={vstory.key}>{vstory.en}</p>
            <ul class="why-list">
              {wsegs.map((s) => (
                <li class="why-item">
                  <span class="why-item__ico"><Fragment set:html={checkIco} /></span>
                  <span data-i18n={s.key} data-i18n-vars={s.vars ? JSON.stringify(s.vars) : undefined} data-i18n-map={s.map ? JSON.stringify(s.map) : undefined}>{tf(s.key, 'en', s.vars || {})}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Opportunity assessment (only if this repo is in the opportunity index) -->
      {opp && (
        <section class="section" id="opportunity">
          <div class="panel">
            <div class="panel__head">
              <span class="panel__title" data-i18n="proj.oppCard">Opportunity Assessment</span>
              <div class="panel__actions" style="display:flex;align-items:center;gap:var(--sp-3);">
                <span class="badge" data-i18n={`tier.${opp.tier}`}>{({ blue_ocean: 'Blue Ocean', high_potential: 'High Potential', watch: 'Watch' } as any)[opp.tier] || opp.tier}</span>
                <span class={`score-pill ${scoreClass(Number(opp.opportunity_score))}`}>{Number(opp.opportunity_score)?.toFixed(1)}</span>
              </div>
            </div>
            <div class="panel__body">
              <p style="color:var(--text-secondary); font-size:var(--text-sm); line-height:var(--leading-relaxed); margin-bottom:var(--sp-4);" data-i18n="proj.oppCardHint">An early, under-priced bet: strong leading indicators with manageable risk.</p>
              <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:var(--sp-4);">
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);" data-i18n="label.velocity">Velocity</div>
                  <div style="font-family:var(--font-mono);font-weight:600;">{Number(opp.velocity || 0).toFixed(0)}</div>
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);" data-i18n="opp.acceleration">Acceleration</div>
                  <div style="font-family:var(--font-mono);font-weight:600;">{Number(opp.star_growth_acceleration || 0).toFixed(1)}x</div>
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);" data-i18n="opp.contributors7d">New contributors / 7d</div>
                  <div style="font-family:var(--font-mono);font-weight:600;">{opp.contributors_7d ?? 0}</div>
                </div>
                <div>
                  <div style="font-size:var(--text-xs);color:var(--text-muted);" data-i18n="label.health">Health</div>
                  <div style="font-family:var(--font-mono);font-weight:600;">{Math.round(Number(opp.health) || 0)}</div>
                </div>
              </div>
              {opp.brief_zh && (
                <p style="margin-top:var(--sp-4); padding-top:var(--sp-4); border-top:1px solid var(--grid-line); color:var(--text-secondary); font-size:var(--text-sm); line-height:var(--leading-relaxed);">
                  <strong style="color:var(--text);" data-i18n="opp.briefLabel">Opportunity brief:</strong>{' '}<span class="brief-zh">{opp.brief_zh}</span>
                </p>
              )}
              <div style="margin-top:var(--sp-4); font-size:var(--text-xs);">
                <a href={`${base}opportunities`} style="color:var(--accent); text-decoration:none;" data-i18n="section.allOpportunities">All opportunities</a>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Related projects -->
      {related.length > 0 && (
        <section class="section" id="related">
          <div class="panel">
            <div class="panel__head">
              <span class="panel__title" data-i18n="proj.related">Related projects</span>
              <div class="panel__actions" style="font-size:var(--text-xs);color:var(--text-muted);">
                <span data-i18n-cat={project.category}>{project.category}</span>
              </div>
            </div>
            <div class="panel__body panel__body--flush">
              <div class="dtable-wrap">
                <table class="dtable">
                  <thead>
                    <tr>
                      <th data-i18n="proj.related">Project</th>
                      <th class="num" data-i18n="proj.radarScore">Score</th>
                      <th class="num" data-i18n="label.stars">Stars</th>
                      <th class="num" data-i18n="label.velocity">Velocity</th>
                      <th data-i18n="proj.momentum">Momentum</th>
                    </tr>
                  </thead>
                  <tbody>
                    {related.map((r) => {
                      const rState = momentumState(r.velocity || 0, 1);
                      return (
                        <tr>
                          <td class="cell-name"><a href={`${base}project/${r.full_name.split('/')[0]}/${r.full_name.split('/').slice(1).join('/')}`} style="color:var(--text);text-decoration:none;">{r.full_name}</a></td>
                          <td class="num"><span class={`score-pill ${scoreClass(r.radar_score)}`}>{Number(r.radar_score || 0).toFixed(1)}</span></td>
                          <td class="num">{fmt(r.stars || 0)}</td>
                          <td class="num">{Math.round(r.velocity || 0)}</td>
                          <td><span class={`momentum momentum-${rState}`}><span data-i18n={`momentum.${rState}`}>{momentumLabel(rState)}</span></span></td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      )}

    </div>

    <aside class="proj-toc" aria-label="On this page">
      <nav>
        {toc.map((s) => (
          <a href={`#${s.id}`} data-i18n={s.key}>{s.en}</a>
        ))}
      </nav>
    </aside>
  </div>

  <script>
    import { trendChart } from '../../../lib/viz';
    import { radarSvg } from '../../../lib/radarChart';
    import { getLang, t } from '../../../lib/i18n';

    const historySeries = (() => {
      try { return JSON.parse(document.getElementById('historySeriesData')?.textContent || '{}'); }
      catch { return {}; }
    })();

    const SERIES_COLOR = {
      stars: 'var(--green)',
      forks: 'var(--viz-2)',
      contributors: 'var(--viz-4)',
      score: 'var(--accent)',
    };
    const fmt = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1) + 'k' : String(Math.round(n)));
    const fmtDate = (ts) => { try { return new Date(ts).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); } catch { return ''; } };

    function renderTrend(key) {
      const mount = document.getElementById('trendChart');
      if (!mount) return;
      const raw = (historySeries[key] || []).filter((p) => Number.isFinite(p.v));
      const values = raw.map((p) => p.v);
      mount.innerHTML = trendChart(values, { color: SERIES_COLOR[key] || 'var(--accent)', gradientId: 'trend-' + key, height: 180 });
      const range = document.getElementById('trendRange');
      if (range && raw.length >= 2) {
        const first = raw[0], last = raw[raw.length - 1];
        const diff = last.v - first.v;
        range.innerHTML =
          `<span>${fmtDate(first.t)} · ${fmt(first.v)}</span>` +
          `<span style="color:${diff >= 0 ? 'var(--green)' : 'var(--red)'};">${diff >= 0 ? '+' : ''}${fmt(diff)}</span>` +
          `<span>${fmtDate(last.t)} · ${fmt(last.v)}</span>`;
      } else if (range) {
        range.innerHTML = '';
      }
    }

    const toggle = document.getElementById('trendToggle');
    if (toggle) {
      const btns = Array.from(toggle.querySelectorAll('.segmented__btn'));
      btns.forEach((b) => b.addEventListener('click', () => {
        btns.forEach((x) => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
        b.classList.add('active');
        b.setAttribute('aria-pressed', 'true');
        renderTrend(b.dataset.series);
      }));
    }
    renderTrend((document.getElementById('trendChart')?.dataset.default) || 'stars');

    function axisLabels(lang) {
      return [t('label.impact', lang), t('label.velocity', lang), t('label.health', lang)];
    }
    function renderProjectRadar() {
      const mount = document.getElementById('projectRadar');
      if (!mount) return;
      const values = {
        impact: Number(mount.dataset.impact) || 0,
        velocity: Number(mount.dataset.velocity) || 0,
        health: Number(mount.dataset.health) || 0,
      };
      mount.innerHTML = radarSvg(values, { size: 240, labels: axisLabels(getLang()) });
    }
    renderProjectRadar();
    document.addEventListener('radar:lang', renderProjectRadar);
  </script>

  <script>
    import { wirePinButtons } from '../../../lib/watchlist';
    wirePinButtons(document);
  </script>

  <style is:global>
    .proj-layout { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: var(--sp-8); align-items: start; }
    .proj-content { min-width: 0; }
    .proj-toc { position: sticky; top: calc(var(--nav-height) + var(--sp-6)); }
    .proj-toc nav { display: flex; flex-direction: column; gap: 2px; border-left: 1px solid var(--grid-line); }
    .proj-toc a {
      padding: var(--sp-2) var(--sp-4); font-size: var(--text-sm); color: var(--text-muted);
      text-decoration: none; border-left: 2px solid transparent; margin-left: -1px;
      transition: color var(--transition-fast), border-color var(--transition-fast);
    }
    .proj-toc a:hover { color: var(--text); border-left-color: var(--accent); }
    .gauge-row { display: flex; flex-wrap: wrap; gap: var(--sp-8); justify-content: center; padding-top: var(--sp-6); margin-top: var(--sp-6); border-top: 1px solid var(--grid-line); }
    .gauge-item { display: flex; flex-direction: column; align-items: center; gap: var(--sp-2); }
    .gauge-item__cap { font-size: var(--text-xs); color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-wide); }
    .gauge-item__sub { font-size: var(--text-xs); color: var(--text-muted); font-family: var(--font-mono); }
    .why-list { list-style: none; display: grid; gap: var(--sp-2); margin: 0; padding: 0; }
    .why-item { display: flex; align-items: flex-start; gap: var(--sp-3); font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); }
    .why-item__ico { flex-shrink: 0; width: 18px; height: 18px; color: var(--green); margin-top: 1px; }
    .why-item__ico svg { width: 18px; height: 18px; display: block; }
    @media (max-width: 1024px) {
      .proj-layout { grid-template-columns: minmax(0, 1fr); }
      .proj-toc { display: none; }
    }
  </style>
</Layout>
