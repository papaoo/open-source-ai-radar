---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { heatColor, norm } from '../lib/viz';

const base = import.meta.env.BASE_URL;
let intelligence: any = { categories: [] };
try { intelligence = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch {}

function catUrl(name: string): string {
  return `${base}category/${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
}

const cats = (intelligence.categories || []).filter((c: any) => (c.tracked || 0) > 0);
const velVals = cats.map((c: any) => c.velocity || 0);
const vMin = Math.min(...velVals, 0);
const vMax = Math.max(...velVals, 1);
const trackedMax = Math.max(...cats.map((c: any) => c.tracked || 0), 1);
---

<Layout title="Categories" description="AI open-source project categories with momentum intelligence.">
  <div class="page-head">
    <div class="page-head__main">
      <div class="page-head__eyebrow" data-i18n="categories.accent">Categories</div>
      <h1 class="page-head__title"><span data-i18n="categories.prefix">AI</span> <span class="accent" data-i18n="categories.accent">Categories</span></h1>
      <p class="page-head__sub" data-i18n="categories.subtitle" data-i18n-vars={JSON.stringify({ n: cats.length })}>{cats.length} categories tracked with momentum intelligence</p>
    </div>
  </div>

  <div class="panel">
    <div class="panel__head">
      <span class="panel__title" data-i18n="section.categoryMomentum">Category momentum</span>
      <div class="panel__actions" style="font-size:var(--text-xs);color:var(--text-muted);" data-i18n="categories.legendVelocity">Bar length = tracked projects · color = velocity</div>
    </div>
    <div class="panel__body">
      <div class="heat-grid">
        {cats.map((cat: any) => (
          <a class="heat-cell" href={catUrl(cat.category)} style="text-decoration:none;color:inherit;">
            <span class="heat-cell__bar" style={`width:${Math.max(8, Math.round(((cat.tracked || 0) / trackedMax) * 100))}%;background:${heatColor(norm(cat.velocity || 0, vMin, vMax))};`}></span>
            <div class="heat-cell__name" data-i18n-cat={cat.category}>{cat.category}</div>
            <div class="heat-cell__meta">
              <span data-i18n="categories.tracked">Tracked</span> · {cat.tracked}
            </div>
            <div class="heat-cell__value">
              <span class={`badge ${(cat.trend === 'rising') ? 'badge-success' : (cat.trend === 'declining') ? 'badge-warning' : 'badge-muted'}`} data-i18n={`trend.${cat.trend}`}>{cat.trend || '—'}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
