---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { bars } from '../lib/viz';

const base = import.meta.env.BASE_URL;
let stats: any = { top_languages: {} };
try { stats = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'stats.json'), 'utf-8')); } catch {}

const languages = Object.entries(stats.top_languages || {})
  .sort((a: any, b: any) => b[1] - a[1]);
const items = languages.map(([lang, count]: any) => ({ label: String(lang), value: Number(count), display: Number(count).toLocaleString() }));
---

<Layout title="Languages" description="Programming languages used across tracked AI projects.">
  <div class="page-head">
    <div class="page-head__main">
      <div class="page-head__eyebrow" data-i18n="section.languageDist">Language distribution</div>
      <h1 class="page-head__title"><span class="accent">Languages</span></h1>
      <p class="page-head__sub">{languages.length} languages across all tracked projects</p>
    </div>
  </div>

  <div class="panel">
    <div class="panel__head">
      <span class="panel__title" data-i18n="section.languageDist">Language distribution</span>
      <div class="panel__actions" style="font-size:var(--text-xs);color:var(--text-muted);" data-i18n="languages.legendProjects">Projects per language</div>
    </div>
    <div class="panel__body">
      <Fragment set:html={bars(items)} />
    </div>
  </div>
</Layout>
