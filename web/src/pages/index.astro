---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';
import { zhDesc } from '../utils/zh';

const base = import.meta.env.BASE_URL;

let stats = { total_repos: 0, total_stars: 0, top_languages: {} as Record<string, number> };
let topRepos: any[] = [];
let trends: any = {};
let breakouts = { candidates: [] as any[] };
let opps: any = { candidates: [] };

try { stats = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'stats.json'), 'utf-8')); } catch {}
try { topRepos = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'top.json'), 'utf-8')).repos?.slice(0, 50) || []; } catch {}
try { trends = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'trends.json'), 'utf-8')); } catch {}
try { breakouts = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'breakouts.json'), 'utf-8')); } catch {}
try { opps = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'opportunities.json'), 'utf-8')); } catch {}

const catIntelligence = (() => {
  try { return JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'category-intelligence.json'), 'utf-8')); } catch { return { categories: [] as any[] }; }
})();

const avatarByRepo = (() => {
  try {
    const idx = JSON.parse(readFileSync(join(process.cwd(), '..', 'data', 'exports', 'projects-index.json'), 'utf-8'));
    const map: Record<string, string> = {};
    for (const p of idx.projects || []) if (p.full_name && p.owner_avatar) map[p.full_name] = p.owner_avatar;
    return map;
  } catch { return {} as Record<string, string>; }
})();

function fmt(n: number): string {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(1) + 'k';
  return n.toString();
}

function scoreClass(s: number): string {
  if (s >= 75) return 'score-high';
  if (s >= 50) return 'score-mid';
  return 'score-low';
}

function momentumState(velocity: number, accel: number): string {
  if (accel >= 2.0 && velocity >= 60) return 'breakout';
  if (accel >= 1.5 && velocity >= 50) return 'accelerating';
  if (velocity >= 40) return 'rising';
  if (velocity >= 20) return 'stable';
  return 'declining';
}

function momentumLabel(state: string): string {
  const labels: Record<string, string> = { breakout: 'Breakout', accelerating: 'Accelerating', rising: 'Rising', stable: 'Stable', declining: 'Declining' };
  return labels[state] || '—';
}

function momentumIcon(state: string): string {
  const icons: Record<string, string> = {
    breakout: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 14l4-4 3 3 7-7"/></svg>',
    accelerating: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l4-6 3 3 5-7"/></svg>',
    rising: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 14l3-4 3 2 6-8"/></svg>',
    stable: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><line x1="1" y1="10" x2="15" y2="10"/></svg>',
    declining: '<svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4l4 4 3-2 5 6"/></svg>',
  };
  return icons[state] || '';
}

function repoUrl(name: string): string {
  const [owner, repo] = name.split('/');
  return `${base}project/${owner}/${repo}`;
}

function ownerInitials(fullName: string): string {
  const owner = fullName.split('/')[0] || '?';
  return owner.replace(/[^a-zA-Z0-9]/g, '').substring(0, 2).toUpperCase() || '?';
}
---

<Layout title="Home" description="Discover what is becoming important in open-source AI. Velocity scoring, momentum tracking, breakout detection for 9,000+ projects." canonical={base}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Open Source AI Radar",
    "url": new URL(base, Astro.site).href,
    "description": "Discover what is becoming important before everyone else does."
  }}>

  <section class="hero-editorial hero-flex">
    <div>
      <h1><span data-i18n="home.titlePrefix">Discover</span> <span class="accent" data-i18n="home.titleAccent">momentum</span> <span data-i18n="home.titleSuffix">in open-source AI</span></h1>
      <p data-i18n="home.subtitle">Track 9,000+ projects scored by impact, velocity, and health. Updated daily.</p>
    </div>
    <div class="hero-radar" aria-hidden="true"></div>
  </section>

  <div class="stat-grid" style="margin-bottom: var(--sp-12);">
    <div class="stat-card">
      <div class="stat-value">{fmt(stats.total_repos || 0)}</div>
      <div class="stat-label" data-i18n="stat.projects">Projects Tracked</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{fmt(stats.total_stars || 0)}</div>
      <div class="stat-label" data-i18n="stat.stars">Total Stars</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{Object.keys(stats.top_languages || {}).length}</div>
      <div class="stat-label" data-i18n="stat.languages">Languages</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{catIntelligence.categories?.length || 0}</div>
      <div class="stat-label" data-i18n="stat.categories">AI Categories</div>
    </div>
  </div>

  {breakouts.candidates && breakouts.candidates.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2 data-i18n="section.breakouts">Breakout Candidates</h2>
        <a href={`${base}breakouts`} data-i18n="section.viewAll">View all</a>
      </div>
      <div class="grid-3">
        {breakouts.candidates.slice(0, 3).map((r: any, i: number) => (
          <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-5); text-decoration:none; color:inherit;">
            <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-3);">
              <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">#{i + 1}</span>
              <span style="font-weight:600; font-size:var(--text-sm);">{r.repo_full_name}</span>
            </div>
            <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-2);">
              <span class={`score-pill ${scoreClass(r.breakout_score)}`}>{r.breakout_score}</span>
              <span class="momentum momentum-breakout" data-i18n="momentum.breakout">Breakout</span>
            </div>
            <div style="display:flex; gap:var(--sp-4); font-size:var(--text-xs); color:var(--text-secondary);">
              <span>{fmt(r.stars || 0)} <span data-i18n="unit.stars">stars</span></span>
              <span>{r.velocity} <span data-i18n="label.vel">vel</span></span>
              <span>{r.star_growth_acceleration}x <span data-i18n="label.accel">accel</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {opps.candidates && opps.candidates.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2 data-i18n="section.opportunities">Latest Opportunities</h2>
        <a href={`${base}opportunities`} data-i18n="section.allOpportunities">All opportunities</a>
      </div>
      <div class="grid-3">
        {opps.candidates.slice(0, 3).map((r: any, i: number) => (
          <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-5); text-decoration:none; color:inherit;">
            <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-3);">
              <span style="font-family:var(--font-mono); font-size:var(--text-xs); color:var(--text-muted);">#{i + 1}</span>
              <span style="font-weight:600; font-size:var(--text-sm); min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{r.repo_full_name}</span>
            </div>
            <div style="display:flex; align-items:center; gap:var(--sp-3); margin-bottom:var(--sp-2); flex-wrap:wrap;">
              <span class={`score-pill ${scoreClass(r.opportunity_score)}`}>{r.opportunity_score}</span>
              <span class="badge" data-i18n={`tier.${r.tier}`}>{({ blue_ocean: 'Blue Ocean', high_potential: 'High Potential', watch: 'Watch' } as any)[r.tier] || r.tier}</span>
            </div>
            <div style="font-size:var(--text-xs); color:var(--text-muted); margin-bottom:var(--sp-2);">
              <span data-i18n-cat={r.category || 'Uncategorized'}>{r.category || 'Uncategorized'}</span>
            </div>
            <div style="display:flex; gap:var(--sp-4); font-size:var(--text-xs); color:var(--text-secondary);">
              <span>{fmt(r.stars || 0)} <span data-i18n="unit.stars">stars</span></span>
              <span>{r.star_growth_acceleration}x <span data-i18n="label.accel">accel</span></span>
              <span>+{r.contributors_7d ?? 0} <span data-i18n="opp.contributors7d">New contributors / 7d</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {catIntelligence.categories && catIntelligence.categories.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2 data-i18n="section.categories">AI Categories</h2>
        <a href={`${base}categories`} data-i18n="section.explore">Explore</a>
      </div>
      <div class="grid-4">
        {catIntelligence.categories.slice(0, 8).map((cat: any) => (
          <div class="card" style="padding:var(--sp-5);">
            <div style="font-weight:600; font-size:var(--text-sm); margin-bottom:var(--sp-1);" data-i18n-cat={cat.category}>{cat.category}</div>
            <div style="font-size:var(--text-xs); color:var(--text-secondary);"><span data-i18n="unit.nProjects" data-i18n-vars={JSON.stringify({ n: cat.tracked })}>{cat.tracked} projects</span></div>
            {cat.trend && <div style={`font-size:var(--text-xs); color:${cat.trend === 'stable' ? 'var(--text-secondary)' : cat.trend === 'declining' ? 'var(--red)' : 'var(--green)'}; margin-top:var(--sp-2);`} data-i18n={`trend.${cat.trend}`}>{cat.trend}</div>}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2 data-i18n="section.topRanked">Top Ranked</h2>
      <a href={`${base}top`} data-i18n="section.fullRankings">Full rankings</a>
    </div>
    <div>
      {topRepos.slice(0, 20).map((r: any, i: number) => {
        const state = momentumState(r.velocity || 0, r.star_growth_acceleration || 1);
        return (
          <a href={repoUrl(r.full_name)} class="project-row">
            <span class="project-rank">{i + 1}</span>
            {r.owner_avatar
              ? <img src={r.owner_avatar} alt="" class="project-avatar" width="32" height="32" loading="lazy" data-owner={r.full_name} referrerpolicy="no-referrer" />
              : <div class="avatar-slot avatar-fallback">{ownerInitials(r.full_name)}</div>}
            <div class="project-info">
              <div class="project-name">{r.full_name}</div>
              {r.description && <div class="project-desc" data-desc-en={r.description} data-desc-zh={zhDesc(r.description)}>{r.description}</div>}
            </div>
            <span class="project-stars">{fmt(r.stars || 0)}</span>
            <span class={`score-pill ${scoreClass(r.radar_score)}`}>{r.radar_score?.toFixed(1)}</span>
            <span class={`momentum momentum-${state}`}>
              <Fragment set:html={momentumIcon(state)} />
              <span data-i18n={`momentum.${state}`}>{momentumLabel(state)}</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  {trends.top_rising && trends.top_rising.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2 data-i18n="section.risingFast">Rising Fast</h2>
        <a href={`${base}trending`} data-i18n="section.allTrending">All trending</a>
      </div>
      <div class="grid-auto">
        {trends.top_rising.slice(0, 6).map((r: any) => {
          const state = momentumState(r.velocity || 0, r.star_growth_acceleration || 1);
          return (
            <a href={repoUrl(r.repo_full_name)} class="card card-link" style="padding:var(--sp-5); text-decoration:none; color:inherit;">
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--sp-2); gap:var(--sp-2);">
                <span style="display:flex; align-items:center; gap:var(--sp-3); min-width:0;">
                  {avatarByRepo[r.repo_full_name]
                    ? <img src={avatarByRepo[r.repo_full_name]} alt="" width="28" height="28" style="width:28px; height:28px; border-radius:50%; object-fit:cover; flex-shrink:0;" loading="lazy" data-owner={r.repo_full_name} referrerpolicy="no-referrer" />
                    : <span class="avatar-fallback" style="width:28px; height:28px; font-size:11px;">{ownerInitials(r.repo_full_name)}</span>}
                  <span style="font-weight:600; font-size:var(--text-sm); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{r.repo_full_name.split('/')[1]}</span>
                </span>
                <span class={`momentum momentum-${state}`} data-i18n={`momentum.${state}`}>{momentumLabel(state)}</span>
              </div>
              <div style="font-size:var(--text-xs); color:var(--text-muted);">
                <span data-i18n-cat={r.category || 'Uncategorized'}>{r.category || 'Uncategorized'}</span> · {fmt(r.stars || 0)} <span data-i18n="unit.stars">stars</span>
              </div>
              <div style="margin-top:var(--sp-3); display:flex; gap:var(--sp-4); font-size:var(--text-xs); color:var(--text-secondary);">
                <span><span data-i18n="label.velocity">Velocity</span>: {r.velocity?.toFixed(0)}</span>
                <span><span data-i18n="label.score">Score</span>: {r.radar_score?.toFixed(1)}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
</Layout>
