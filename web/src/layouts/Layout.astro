---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: object;
  ogImage?: string;
}

const {
  title,
  description = "Discover what is becoming important before everyone else does. Track 0+ AI open-source projects with velocity scoring, anomaly detection, and breakout predictions.",
  canonical,
  jsonLd,
  ogImage,
} = Astro.props;

// GoatCounter analytics — create a free account at goatcounter.com and put
// your site code here (e.g. "example"). Left empty = analytics disabled.
const GOATCOUNTER_SITE = import.meta.env.PUBLIC_GOATCOUNTER_SITE || "";

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site!.origin;
const fullUrl = new URL(canonical || Astro.url.pathname, Astro.site).href;
const socialImage = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}${base}favicon.svg`;

// Nav items carry an i18n key (runtime swaps the text) plus an English default
// so the server-rendered HTML is correct before any script runs.
const navItems = [
  { href: `${base}`, key: "nav.home", en: "Home" },
  { href: `${base}top`, key: "nav.rankings", en: "Rankings" },
  { href: `${base}trending`, key: "nav.trending", en: "Trending" },
  { href: `${base}breakouts`, key: "nav.breakouts", en: "Breakouts" },
  { href: `${base}opportunities`, key: "nav.opportunities", en: "Opportunities" },
  { href: `${base}categories`, key: "nav.categories", en: "Categories" },
  { href: `${base}digests`, key: "nav.digests", en: "Digests" },
  { href: `${base}api-docs`, key: "nav.api", en: "API" },
];
---

<!doctype html>
<html lang="en" data-lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Open Source AI Radar</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles/tokens.css`} />
    <link rel="stylesheet" href={`${base}styles/base.css`} />
    <link rel="stylesheet" href={`${base}styles/components.css`} />
    <link rel="stylesheet" href={`${base}styles/terminal.css`} />
    <link rel="stylesheet" href={`${base}styles/viz.css`} />
    <script is:inline>
      // Pre-paint: apply saved language + theme before CSS/first frame to avoid flash.
      (function () {
        try {
          var d = document.documentElement;
          var lang = localStorage.getItem("radar-lang");
          if (lang !== "en" && lang !== "zh") {
            lang = (navigator.language || "").toLowerCase().indexOf("zh") === 0 ? "zh" : "en";
          }
          d.setAttribute("data-lang", lang);
          d.setAttribute("lang", lang === "zh" ? "zh-CN" : "en");
          var theme = localStorage.getItem("radar-theme");
          if (theme !== "light" && theme !== "dark") {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          d.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <meta property="og:title" content={`${title} — Open Source AI Radar`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Open Source AI Radar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Open Source AI Radar`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {GOATCOUNTER_SITE && (
      <script is:inline data-goatcounter={`https://${GOATCOUNTER_SITE}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
    )}
  
    <style is:global>
      /* Skip link: hidden until keyboard focus. */
      .skip-link {
        position: fixed; left: var(--sp-4); top: -64px; z-index: 300;
        padding: var(--sp-2) var(--sp-4); border-radius: var(--radius);
        background: var(--accent); color: #fff; font-size: var(--text-sm); font-weight: 600;
        transition: top var(--transition-fast);
      }
      .skip-link:focus { top: var(--sp-4); }
      /* Avatar fallback - shows initials when image fails */
      .avatar-fallback {
        width: 32px; height: 32px; border-radius: 50%;
        background: var(--accent); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 600; flex-shrink: 0;
      }
      img[data-failed="true"] { display: none !important; }
    </style>
  </head>
  <body>
    <a href="#main" class="skip-link" data-i18n="a11n.skip">Skip to content</a>
    <nav class="nav" role="navigation" aria-label="Main">
      <div class="nav-inner">
        <a href={base} class="nav-logo" aria-label="Open Source AI Radar home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 4"/>
            <path d="M5 19.5C5.5 18 6 15 6 12c0-3.5 2.5-6 6-6 2 0 3.5 1 4.5 2.5"/>
            <path d="M12 12a3 3 0 1 0 0 6c1.5 0 3-1 3-3 0-1-.5-2-1.5-3"/>
            <circle cx="12" cy="12" r="1"/>
          </svg>
          <span>AI Radar</span>
        </a>

        <button class="nav-mobile-toggle" aria-label="Toggle menu" aria-expanded="false" id="navToggle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <div class="nav-links" id="navLinks" role="menubar">
          {navItems.map(item => (
            <a href={item.href} role="menuitem" data-i18n={item.key}
               aria-current={Astro.url.pathname === item.href || Astro.url.pathname === item.href + "/" ? "page" : undefined}>
              {item.en}
            </a>
          ))}
          <div class="nav-controls">
            <button class="nav-btn nav-cmdk" type="button" data-cmdk-open aria-label="Search" title="Search (Ctrl+K)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:14px;height:14px;"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <kbd class="kbd">Ctrl K</kbd>
            </button>
            <button class="nav-btn" id="langToggle" data-i18n="lang.toggle" data-i18n-aria="lang.aria" aria-label="Switch language">中文</button>
            <button class="nav-btn nav-btn-icon" id="themeToggle" data-i18n-aria="theme.toggle" aria-label="Toggle theme" title="Toggle theme">
              <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
              </svg>
              <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </nav>

    <main class="page" id="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>Open Source AI Radar</span>
        <div class="footer-links">
          <a href={`${base}top`} data-i18n="nav.rankings">Rankings</a>
          <a href={`${base}categories`} data-i18n="nav.categories">Categories</a>
          <a href={`${base}api-docs`} data-i18n="nav.api">API</a>
          <a href="https://github.com/ErBharatMalhotra/open-source-ai-radar" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      import { applyI18n, getLang, toggleLang } from '../lib/i18n';
      import { initCommandPalette } from '../lib/command-palette';

      initCommandPalette();

      // Apply saved language on load (pre-paint script already set data-lang).
      applyI18n(document, getLang());

      const langBtn = document.getElementById('langToggle');
      if (langBtn) langBtn.addEventListener('click', () => toggleLang());

      const themeBtn = document.getElementById('themeToggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('radar-theme', next); } catch {}
        });
      }

      // Sticky-nav shadow after scroll.
      const nav = document.querySelector('.nav');
      if (nav) {
        const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // One-shot reveal-on-scroll for tagged sections/cards.
      const revealEls = document.querySelectorAll('.section, .card, .project-row');
      if ('IntersectionObserver' in window && revealEls.length) {
        revealEls.forEach((el) => el.classList.add('reveal'));
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach((el) => io.observe(el));
      }
    </script>

    <script>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      if (toggle && links) {
        toggle.addEventListener('click', () => {
          const open = links.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      }
    </script>
  
    <script>
      (function() {
        function replaceWithFallback(img) {
          if (!img.parentNode) return;
          var name = img.getAttribute('data-owner') || '?';
          var initials = name.split('/')[0].replace(/[^a-zA-Z0-9]/g, '').substring(0, 2).toUpperCase() || '?';
          var fallback = document.createElement('div');
          fallback.className = 'avatar-fallback';
          fallback.textContent = initials;
          fallback.style.width = img.getAttribute('width') || '32px';
          fallback.style.height = img.getAttribute('height') || '32px';
          img.parentNode.replaceChild(fallback, img);
        }
        document.addEventListener('error', function(e) {
          var t = e.target;
          if (t && t.tagName === 'IMG' && t.hasAttribute('data-owner')) {
            replaceWithFallback(t);
          }
        }, true);
        document.querySelectorAll('img[data-owner]').forEach(function(img) {
          img.referrerPolicy = 'no-referrer';
          if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) {
            replaceWithFallback(img);
          }
        });
      })();
    </script>
  </body>
</html>
